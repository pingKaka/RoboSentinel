# Copy this file to remote.env. remote.env is ignored by Git.
REMOTE_HOST=192.0.2.10
REMOTE_USER=ubuntu
REMOTE_PORT=22
REMOTE_WORKDIR=/data/ubuntu/RoboSentinel

# Leave empty to use the SSH agent/default key.
REMOTE_IDENTITY_FILE=

# Conda initialization and environment on the remote host.
REMOTE_CONDA_SH=/opt/conda/etc/profile.d/conda.sh
REMOTE_CONDA_ENV=robosentinel-train

# Local adapter download destination.
LOCAL_OUTPUT_DIR=training/downloaded_output
